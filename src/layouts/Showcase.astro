---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "ViViD Lab — Research Showcase" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
  </head>
  <body class="overflow-hidden">
    <div id="showcase" class="showcase-root">
      <slot />
    </div>

    <!-- Section indicator (top-right) -->
    <div
      id="indicator"
      class="fixed top-5 right-6 text-[11px] tracking-[0.18em] uppercase text-ink-mute font-semibold pointer-events-none select-none z-50"
    >
      <span id="cur">01</span><span class="text-ink-mute/50"> / </span><span id="tot">00</span>
    </div>

    <!-- Hint (bottom) -->
    <div
      class="fixed bottom-5 left-1/2 -translate-x-1/2 text-[10px] tracking-[0.22em] uppercase text-ink-mute/70 pointer-events-none select-none z-50"
    >
      Scroll · ↓ · Space
    </div>

    <style is:global>
      /* Showcase-specific: scroll-snap presentation */
      .showcase-root {
        scroll-snap-type: y mandatory;
        overflow-y: scroll;
        height: 100vh;
        scroll-behavior: smooth;
      }
      .showcase-section {
        scroll-snap-align: start;
        scroll-snap-stop: always;
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 4rem 1.5rem;
      }
      @media (min-width: 1024px) {
        .showcase-section {
          padding: 5rem 2rem;
        }
      }
    </style>

    <script is:inline>
      const root = document.getElementById("showcase");
      const sections = root.querySelectorAll(".showcase-section");
      const cur = document.getElementById("cur");
      const tot = document.getElementById("tot");
      tot.textContent = String(sections.length).padStart(2, "0");

      let activeIdx = 0;

      // Update indicator on scroll
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && e.intersectionRatio > 0.5) {
              const idx = Array.from(sections).indexOf(e.target);
              if (idx >= 0) {
                activeIdx = idx;
                cur.textContent = String(idx + 1).padStart(2, "0");
              }
            }
          });
        },
        { root, threshold: [0.5] }
      );
      sections.forEach((s) => io.observe(s));

      // Keyboard navigation
      const goTo = (i) => {
        const target = sections[Math.max(0, Math.min(sections.length - 1, i))];
        if (target) target.scrollIntoView({ behavior: "smooth" });
      };
      window.addEventListener("keydown", (e) => {
        if (["ArrowDown", "PageDown", " ", "j", "ArrowRight"].includes(e.key)) {
          e.preventDefault();
          goTo(activeIdx + 1);
        } else if (["ArrowUp", "PageUp", "k", "ArrowLeft"].includes(e.key)) {
          e.preventDefault();
          goTo(activeIdx - 1);
        } else if (e.key === "Home") {
          e.preventDefault();
          goTo(0);
        } else if (e.key === "End") {
          e.preventDefault();
          goTo(sections.length - 1);
        }
      });
    </script>
  </body>
</html>
