---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  photo?: ImageMetadata;
  name: string;
  role: string;
  email?: string;
  links?: { label: string; href: string }[];
}

const { photo, name, role, email, links } = Astro.props;

type IconKind = "scholar" | "github" | "linkedin" | "homepage" | "external";

// Single-path (fill) glyphs, 24×24. Brand marks from Simple Icons; homepage/external
// from Heroicons (solid). Kept inline so cards stay self-contained.
const ICON_PATHS: Record<IconKind, string> = {
  homepage:
    "M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689ZM12 5.432l8.159 8.159c.03.03.058.06.084.091v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198c.026-.03.054-.06.084-.09L12 5.43Z",
  scholar:
    "M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z",
  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  external:
    "M15.75 2.25H21a.75.75 0 0 1 .75.75v5.25a.75.75 0 0 1-1.5 0V4.81L8.03 17.03a.75.75 0 0 1-1.06-1.06L19.19 3.75h-3.44a.75.75 0 0 1 0-1.5Zm-10.5 4.5a1.5 1.5 0 0 0-1.5 1.5v10.5a1.5 1.5 0 0 0 1.5 1.5h10.5a1.5 1.5 0 0 0 1.5-1.5V10.5a.75.75 0 0 1 1.5 0v8.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V8.25a3 3 0 0 1 3-3h8.25a.75.75 0 0 1 0 1.5H5.25Z",
};

const kindFor = (label: string): IconKind => {
  const l = label.toLowerCase();
  if (l.includes("scholar")) return "scholar";
  if (l.includes("github")) return "github";
  if (l.includes("linkedin")) return "linkedin";
  if (l.includes("homepage") || l.includes("website") || l.includes("home") || l.includes("site"))
    return "homepage";
  return "external";
};

// Email stays as a readable address; external profiles render as an icon row.
const iconLinks = (links ?? []).map((l) => ({
  kind: kindFor(l.label),
  label: l.label,
  href: l.href,
}));
---

<li class="rounded-2xl border border-line overflow-hidden bg-paper">
  {
    photo ? (
      <Image
        src={photo}
        alt={name}
        width={420}
        class="w-full aspect-square object-cover object-top"
      />
    ) : (
      <div class="w-full aspect-square bg-paper-soft border-b border-line flex items-center justify-center text-ink-mute">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="w-12 h-12"
          aria-hidden="true"
        >
          <circle cx="12" cy="8.5" r="4" />
          <path d="M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" stroke-linecap="round" />
        </svg>
      </div>
    )
  }
  <div class="p-4">
    <h3 class="font-display text-[15px] font-semibold text-ink leading-tight">
      {name}
    </h3>
    <p class="mt-0.5 text-xs text-ink-soft">{role}</p>
    {
      (email || iconLinks.length > 0) && (
        <div class="mt-2.5 space-y-2">
          {email && (
            <a
              href={`mailto:${email}`}
              class="block break-all text-xs text-cyan-deep underline underline-offset-4 decoration-cyan-deep/40 hover:decoration-cyan-deep hover:text-cyan transition-colors"
            >
              {email}
            </a>
          )}
          {iconLinks.length > 0 && (
            <ul class="-ml-1.5 flex flex-wrap gap-1">
              {iconLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-label={l.label}
                    title={l.label}
                    class="flex h-8 w-8 items-center justify-center rounded-lg text-ink-mute transition-colors hover:bg-cyan-deep/10 hover:text-cyan-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-deep/50"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
                      <path d={ICON_PATHS[l.kind]} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
</li>
