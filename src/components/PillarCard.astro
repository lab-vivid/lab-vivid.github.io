---
interface Props {
  title: string;
  subtitle: string;
  topics: string[];
}
const { title, subtitle, topics } = Astro.props;
---

<article
  class="group p-5 border border-line rounded-xl bg-paper hover:border-cyan/60 hover:shadow-[0_0_0_4px_rgb(6_182_212/0.05)] transition-all duration-200"
>
  <h3 class="font-display text-base font-semibold text-ink tracking-tight">
    {title}
  </h3>
  <p class="mt-1 text-xs text-ink-soft">{subtitle}</p>
  <ul class="mt-3.5 flex flex-wrap gap-1.5">
    {
      topics.map((t) => (
        <li class="px-2.5 py-1 text-[11px] rounded-full bg-paper-soft border border-line text-ink-soft group-hover:border-cyan/30 group-hover:text-ink transition-colors">
          {t}
        </li>
      ))
    }
  </ul>
</article>
