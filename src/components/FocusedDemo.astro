---
interface Props {
  number: string;
  title: string;
  subtitle: string;
  label: string;
  refTitle?: string;
  refAuthors?: string;
  refVenue?: string;
  refLink?: string;
}
const {
  number,
  title,
  subtitle,
  label,
  refTitle,
  refAuthors,
  refVenue,
  refLink,
} = Astro.props;
---

<!-- Single wide container for header + demo so left/right edges line up -->
<div class="max-w-6xl mx-auto w-full">
  <header>
    <div
      class="font-display text-base lg:text-lg tracking-[0.22em] text-cyan-deep font-semibold uppercase"
    >
      Pillar {number}
    </div>
    <h2
      class="mt-3 font-display text-4xl lg:text-5xl tracking-tight font-semibold text-ink leading-tight"
    >
      {title}
    </h2>
    <p class="mt-3 text-lg lg:text-xl text-ink-soft">{subtitle}</p>
  </header>

  <div class="mt-6 lg:mt-8">
    <div
      class="text-base uppercase tracking-[0.16em] text-ink font-semibold mb-3"
    >
      {label}
    </div>
    <div
      class="rounded-lg overflow-hidden bg-paper-soft border border-line"
    >
      <slot />
    </div>
    {
      refTitle && (
        <p class="mt-3 text-sm text-ink-soft leading-snug">
          {refLink ? (
            <a
              href={refLink}
              target="_blank"
              rel="noopener"
              class="hover:text-navy underline-offset-2 hover:underline"
            >
              {refTitle}
            </a>
          ) : (
            <span>{refTitle}</span>
          )}
          {refAuthors && <span class="text-ink-soft"> · {refAuthors}</span>}
          {refVenue && (
            <span class="ml-2 inline-block px-2 py-0.5 rounded text-xs uppercase tracking-wider bg-navy-soft text-navy font-semibold">
              {refVenue}
            </span>
          )}
        </p>
      )
    }
  </div>
</div>
