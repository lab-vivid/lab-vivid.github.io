---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import hyeongminPhoto from "../assets/people/hyeongmin.jpeg";
import { students } from "../data/people";

const studentPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/people/*.{jpg,jpeg,png}",
  { eager: true },
);
const photoFor = (file?: string) =>
  file ? studentPhotos[`../assets/people/${file}`]?.default : undefined;

const links = [
  {
    label: "hyeongmin.lee@seoultech.ac.kr",
    href: "mailto:hyeongmin.lee@seoultech.ac.kr",
    external: false,
  },
  {
    label: "Google Scholar",
    href: "https://scholar.google.co.kr/citations?user=eEB3K6gAAAAJ",
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/HyeongminLEE",
    external: true,
  },
  {
    label: "Personal website",
    href: "https://hyeongminlee.github.io",
    external: true,
  },
];

---

<Base
  title="People — ViViD Lab"
  description="The people behind ViViD Lab — Vision and Video Dynamics Lab at SeoulTech."
>
  <header class="mx-auto max-w-6xl px-6 lg:px-8 pt-16 lg:pt-20 pb-12 lg:pb-16">
    <p
      class="text-[11px] uppercase tracking-[0.22em] text-cyan-deep font-semibold"
    >
      Vision and Video Dynamics Lab · People
    </p>
    <h1
      class="mt-5 font-display text-[2rem] lg:text-[2.5rem] leading-[1.12] tracking-tight font-semibold text-ink max-w-3xl"
    >
      The people behind ViViD Lab.
    </h1>
  </header>

  <div class="mx-auto max-w-6xl px-6 lg:px-8 pb-24">
    <div class="space-y-16 lg:space-y-24">

      <!-- Professor -->
      <section>
        <h2
          class="font-display text-lg lg:text-xl tracking-tight font-semibold text-ink"
        >
          Professor
        </h2>

        <ul
          class="mt-8 lg:mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-6"
        >
          <li class="rounded-2xl border border-line overflow-hidden bg-paper">
            <Image
              src={hyeongminPhoto}
              alt="Hyeongmin Lee"
              width={420}
              class="w-full aspect-square object-cover object-top"
            />
            <div class="p-4">
              <h3 class="font-display text-[15px] font-semibold text-ink leading-tight">
                Hyeongmin Lee
              </h3>
              <p class="mt-0.5 text-xs text-ink-soft">Assistant Professor</p>
              <ul class="mt-2.5 space-y-1 text-xs">
                {
                  links.map((l) =>
                    l.external ? (
                      <li>
                        <a
                          href={l.href}
                          class="inline-flex items-center gap-0.5 text-cyan-deep underline underline-offset-4 decoration-cyan-deep/40 hover:decoration-cyan-deep hover:text-cyan transition-colors"
                        >
                          {l.label}
                          <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ) : (
                      <li>
                        <a
                          href={l.href}
                          class="break-all text-cyan-deep underline underline-offset-4 decoration-cyan-deep/40 hover:decoration-cyan-deep hover:text-cyan transition-colors"
                        >
                          {l.label}
                        </a>
                      </li>
                    ),
                  )
                }
              </ul>
            </div>
          </li>
        </ul>
      </section>

      <div class="border-t border-line"></div>

      <!-- Students -->
      <section>
        <h2
          class="font-display text-lg lg:text-xl tracking-tight font-semibold text-ink"
        >
          Students
        </h2>

        <ul
          class="mt-8 lg:mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-6"
        >
          {
            students.map((s) => {
              const photo = photoFor(s.photo);
              return (
                <li class="rounded-2xl border border-line overflow-hidden bg-paper">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={s.name}
                      width={420}
                      class="w-full aspect-square object-cover object-top"
                    />
                  ) : (
                    <div class="w-full aspect-square bg-paper-soft border-b border-line flex items-center justify-center text-ink-mute">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="w-12 h-12"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="8.5" r="4" />
                        <path
                          d="M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"
                          stroke-linecap="round"
                        />
                      </svg>
                    </div>
                  )}
                  <div class="p-4">
                    <h3 class="font-display text-[15px] font-semibold text-ink leading-tight">
                      {s.name}
                    </h3>
                    <p class="mt-0.5 text-xs text-ink-soft">{s.role}</p>
                    {(s.email || s.links?.length) && (
                      <ul class="mt-2.5 space-y-1 text-xs">
                        {s.email && (
                          <li>
                            <a
                              href={`mailto:${s.email}`}
                              class="break-all text-cyan-deep underline underline-offset-4 decoration-cyan-deep/40 hover:decoration-cyan-deep hover:text-cyan transition-colors"
                            >
                              {s.email}
                            </a>
                          </li>
                        )}
                        {s.links?.map((l) => (
                          <li>
                            <a
                              href={l.href}
                              class="inline-flex items-center gap-0.5 text-cyan-deep underline underline-offset-4 decoration-cyan-deep/40 hover:decoration-cyan-deep hover:text-cyan transition-colors"
                            >
                              {l.label}
                              <span aria-hidden="true">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-12 lg:mt-14 flex flex-col items-start gap-4">
          <p class="text-sm text-ink-soft">
            We're recruiting at all levels — undergraduate interns, M.S., and
            Ph.D.
          </p>
          <a
            href="/join"
            class="inline-flex items-center px-5 py-2.5 rounded-full bg-navy text-paper hover:bg-navy-deep transition-colors font-medium text-sm"
          >
            Join us →
          </a>
        </div>
      </section>

    </div>
  </div>
</Base>
