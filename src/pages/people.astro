---
import Base from "../layouts/Base.astro";
import type { ImageMetadata } from "astro";
import MemberCard from "../components/MemberCard.astro";
import hyeongminPhoto from "../assets/people/hyeongmin.jpeg";
import { students, collaborators } from "../data/people";

const memberPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/people/*.{jpg,jpeg,png}",
  { eager: true },
);
const photoFor = (file?: string) =>
  file ? memberPhotos[`../assets/people/${file}`]?.default : undefined;

const piEmail = "hyeongmin.lee@seoultech.ac.kr";
const piLinks = [
  {
    label: "Google Scholar",
    href: "https://scholar.google.co.kr/citations?user=eEB3K6gAAAAJ",
  },
  { label: "GitHub", href: "https://github.com/HyeongminLEE" },
  { label: "Personal website", href: "https://hyeongminlee.github.io" },
];

const headingClass =
  "font-display text-lg lg:text-xl tracking-tight font-semibold text-ink";
const gridClass =
  "mt-8 lg:mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-6";
---

<Base
  title="People — ViViD Lab"
  description="The people behind ViViD Lab — Vision and Video Dynamics Lab at SeoulTech."
>
  <header class="mx-auto max-w-6xl px-6 lg:px-8 pt-16 lg:pt-20 pb-12 lg:pb-16">
    <p
      class="text-[11px] uppercase tracking-[0.22em] text-cyan-deep font-semibold"
    >
      Vision and Video Dynamics Lab · People
    </p>
    <h1
      class="mt-5 font-display text-[2rem] lg:text-[2.5rem] leading-[1.12] tracking-tight font-semibold text-ink max-w-3xl"
    >
      The people behind ViViD Lab.
    </h1>
  </header>

  <div class="mx-auto max-w-6xl px-6 lg:px-8 pb-24">
    <div class="space-y-16 lg:space-y-24">

      <!-- Professor -->
      <section>
        <h2 class={headingClass}>Professor</h2>
        <ul class={gridClass}>
          <MemberCard
            photo={hyeongminPhoto}
            name="Hyeongmin Lee"
            role="Assistant Professor"
            email={piEmail}
            links={piLinks}
          />
        </ul>
      </section>

      <div class="border-t border-line"></div>

      <!-- Students -->
      <section>
        <h2 class={headingClass}>Students</h2>
        <ul class={gridClass}>
          {
            students.map((s) => (
              <MemberCard
                photo={photoFor(s.photo)}
                name={s.name}
                role={s.role}
                email={s.email}
                links={s.links}
              />
            ))
          }
        </ul>
      </section>

      <div class="border-t border-line"></div>

      <!-- Collaborators -->
      <section>
        <h2 class={headingClass}>Collaborators</h2>
        <ul class={gridClass}>
          {
            collaborators.map((c) => (
              <MemberCard
                photo={photoFor(c.photo)}
                name={c.name}
                role={c.role}
                email={c.email}
                links={c.links}
              />
            ))
          }
        </ul>
      </section>

      <!-- Recruiting -->
      <div class="flex flex-col items-start gap-4">
        <p class="text-sm text-ink-soft">
          We're recruiting at all levels — undergraduate interns, M.S., and
          Ph.D.
        </p>
        <a
          href="/join"
          class="inline-flex items-center px-5 py-2.5 rounded-full bg-navy text-paper hover:bg-navy-deep transition-colors font-medium text-sm"
        >
          Join us →
        </a>
      </div>

    </div>
  </div>
</Base>
